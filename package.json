    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint apps/server packages"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
