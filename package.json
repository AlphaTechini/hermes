{
  "name": "hermes",
  "version": "0.1.0",
  "private": true,
  "description": "TradingView webhook alerts to Perpl orders, with risk limits and a per-strategy report card.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
