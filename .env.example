# Hermes server configuration. Copy to apps/server/.env (or export in your shell).
# Never commit real values.

# --- HTTP ---------------------------------------------------------------
PORT=8787
# Public HTTPS URL TradingView can reach (e.g. a Cloudflare Tunnel). Used to build webhook URLs.
PUBLIC_BASE_URL=http://localhost:8787
# Origin of the web app, for CORS.
WEB_ORIGIN=http://localhost:5173

# --- Storage ------------------------------------------------------------
DATABASE_PATH=./data/hermes.db
# 32 bytes as 64 hex chars. Encrypts webhook secrets and Perpl API private keys (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset in development an ephemeral key is generated (data will NOT survive a restart).
HERMES_MASTER_KEY=

# --- Perpl --------------------------------------------------------------
# sim = in-process simulator (default, no network); live = Perpl testnet
PERPL_MODE=sim
PERPL_API_BASE=https://testnet.perpl.xyz/api
PERPL_WS_BASE=wss://testnet.perpl.xyz
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
PERPL_EXCHANGE_ADDRESS=0x1964c32f0be608e7d29302aff5e61268e72080cc

# --- Auth ---------------------------------------------------------------
# privy = verify Privy access tokens; dev = fixed demo user (auto when PRIVY_APP_ID is empty)
AUTH_MODE=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
