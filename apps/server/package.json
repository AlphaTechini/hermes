    "@privy-io/node": "0.35.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "viem": "2.57.4",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
